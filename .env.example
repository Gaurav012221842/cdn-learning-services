# ==============================================================================
# GLOBAL PRODUCTION / STAGING DEPLOYMENT ENVIRONMENT VARIABLES
# Copy this file to .env and provide your production credentials
# ==============================================================================

# Database (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/learning_platform
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_strong_postgres_password

# Docker-Compose Database Setup
POSTGRES_DB=learning_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password

# Redis Cache & Sessions
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_USERNAME=
SPRING_REDIS_PASSWORD=
SPRING_REDIS_SSL_ENABLED=false

# Apache Kafka Event Streaming (Local or Confluent Cloud)
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_API_KEY=your_confluent_api_key
KAFKA_API_SECRET=your_confluent_api_secret

# JWT Security & Session Expiration (24h = 86400000 ms)
JWT_SECRET=your_super_secret_64_character_hex_or_base64_jwt_key_for_production
JWT_EXPIRATION=86400000

# Master Admin Email (Only this user has permission to promote/demote admins)
MASTER_ADMIN_EMAIL=serversidegaurav@gmail.com

# Cloudflare R2 Object Storage (S3-Compatible)
R2_ENDPOINT=https://<your-cloudflare-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET_NAME=learning-platform
R2_CDN_URL=https://your-custom-cdn-domain.r2.dev

# Razorpay Payment Gateway (Optional / Staging)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Notification Service (SMTP / Resend API)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_smtp_email@gmail.com
SPRING_MAIL_PASSWORD=your_16_char_google_app_password

# Brevo Email API (Port 443 HTTPS - Works 100% on Render, sends to ANY recipient!)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=serversidegaurav@gmail.com
BREVO_SENDER_NAME=Gaurav's Learning Platform

# Application Base & Frontend URLs
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
LOCAL_UPLOADS_URL=http://localhost:8080/uploads
